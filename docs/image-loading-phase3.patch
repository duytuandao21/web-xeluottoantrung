+// Footer artwork is below the initial viewport. Defer only images whose
+// existing source ratio reserves their space; new Admin uploads without
+// dimensions retain eager discovery until their metadata is available.
+function footerImageLoading(src: string): 'lazy' | undefined {
+  const dimensions = imageDimensions(src);
+  return dimensions?.width && dimensions.height && !dimensions.animated ? 'lazy' : undefined;
