# Server-side URL used by Next.js to read the public API.
# API_URL=http://localhost:4000
# API_URL=http://52.65.173.30
# Browser requests /api/v1 on the web origin; Next.js proxies them to API_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public build-time image delivery settings. These are not API keys.
# Approved CDN rollout. Set original to roll back image delivery only.
NEXT_PUBLIC_IMAGE_DELIVERY_MODE=cloudflare
NEXT_PUBLIC_IMAGE_CLOUDFLARE_ORIGIN=https://cdn.toantrungxeluot.io.vn
# Exact HTTPS origins only, comma-separated. No wildcards or credentials.
NEXT_PUBLIC_IMAGE_SOURCE_ORIGINS=https://cdn.toantrungxeluot.io.vn
# Map only this known bucket to the CDN BEFORE transformation (no DB rewrite).
NEXT_PUBLIC_IMAGE_LEGACY_R2_ORIGINS=https://pub-edb90463be404b1d8b79b79517518131.r2.dev
# Never use wildcard *.r2.dev or allow another bucket without verifying ownership.
# Changing NEXT_PUBLIC settings requires a new build for server/browser parity.
